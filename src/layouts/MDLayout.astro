---
import Layout from "./Layout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const { frontmatter } = Astro.props;

const images = import.meta.glob<ImageMetadata>("/src/images/*", {
  eager: true,
  import: "default",
});

const cover = images[`/src/images/${frontmatter.image}`];

const { alt = "page cover image" } = frontmatter;
---

<Layout title={frontmatter.title}>
  {cover && <Image src={cover} alt={alt} class="w-full" />}
  <div class="mx-auto py-5 max-2xl:px-5 md:max-w-344">
    <slot />
  </div>
</Layout>
