---
import Layout from "./Layout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata, MarkdownLayoutProps } from "astro";

type Props = MarkdownLayoutProps<{
  title: string;
  coverImage?: string;
  coverAlt?: string;
}>;

const { frontmatter, headings } = Astro.props;

const images = import.meta.glob<ImageMetadata>("/src/images/*", {
  eager: true,
  import: "default",
});

const cover = images[`/src/images/${frontmatter.coverImage}`];

if (frontmatter.coverImage && !cover) {
  throw new Error(
    `Cover image "${frontmatter.coverImage}" not found in /src/images (page: ${Astro.url.pathname})`,
  );
}

const firstHeading = cover ? headings.find((h) => h.depth === 1) : undefined;

let content = await Astro.slots.render("default");
if (firstHeading) {
  content = content.replace(/<h1[\s>].*?<\/h1>/s, "");
}
---

<Layout title={frontmatter.title}>
  {cover && (
    <div class="relative">
      <Image
        src={cover}
        alt={frontmatter.coverAlt ?? ""}
        layout="full-width"
        priority
        class="h-140 max-h-dvh w-full object-cover"
      />
      {firstHeading && (
        <h1
          id={firstHeading.slug}
          class="absolute inset-x-0 bottom-0 bg-linear-to-t from-black/70 to-transparent px-5 pt-24 pb-12 text-center text-4xl font-bold text-white md:text-6xl"
        >
          {firstHeading.text}
        </h1>
      )}
    </div>
  )}
  <div
    class:list={[
      "md-content mx-auto max-w-3xl px-5 pb-5",
      cover ? "pt-5" : "pt-30",
    ]}
    set:html={content}
  />
</Layout>
