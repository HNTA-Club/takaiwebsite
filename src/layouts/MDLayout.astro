---
import Layout from "./Layout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const { frontmatter, headings } = Astro.props;

const images = import.meta.glob<ImageMetadata>("/src/images/*", {
  eager: true,
  import: "default",
});

const cover = images[`/src/images/${frontmatter.image}`];

const { alt = "page cover image" } = frontmatter;

const firstHeading = cover ? headings[0] : undefined;

let content = await Astro.slots.render("default");
if (firstHeading) {
  content = content.replace(/<h[1-6][\s>].*?<\/h[1-6]>/s, "");
}
---

<Layout title={frontmatter.title}>
  {
    cover && (
      <div class="relative">
        <Image
          src={cover}
          alt={alt}
          class="h-dvh max-h-140 w-full object-cover"
        />
        {firstHeading && (
          <h1
            id={firstHeading.slug}
            class="absolute inset-x-0 bottom-0 bg-linear-to-t from-black/70 to-transparent px-5 pt-24 pb-12 text-center text-4xl font-bold text-white md:text-6xl"
          >
            {firstHeading.text}
          </h1>
        )}
      </div>
    )
  }
  <div
    class={`mx-auto py-5 max-2xl:px-5 md:max-w-344 ${cover ? "" : "pt-30"} prose`}
    set:html={content}
  />
</Layout>
