---
import Layout from './Layout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from "astro";

const { frontmatter } = Astro.props;

const images = import.meta.glob<ImageMetadata>('/src/images/*', {
	eager: true,
	import: "default"
});

const cover = images[`/src/images/${frontmatter.image}`];
---
<Layout title={frontmatter.title}>
	{cover && (<Image src={cover} alt="page cover image" class="w-full" />)}
	<div class="py-5 max-md:px-5 mx-auto md:max-w-344">
		<h1 class="text-xl font-bold">{frontmatter.title}</h1>
		<slot />
	</div>
</Layout>