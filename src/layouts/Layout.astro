---
import "../styles/global.css";
import DiscordLogo from "../images/discord.svg";

interface Props {
  title?: string;
}

const { title = "TaKAi Website" } = Astro.props;

const menuLinks = [["/events", "Events"],
                   ["/join", "Join"],
                   ["/gallery", "Gallery"],
                   ["/about", "About"]];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header>
        <div class="fixed z-40 md:top-4 w-full">
            <div class="bg-white md:max-w-[86rem] mx-auto p-5 shadow md:rounded-xl">
                <nav class="flex relative items-center justify-between">
                    <span>logo</span> <!-- placeholder -->
                    <div class="flex gap-x-10 items-center justify-evenly max-lg:hidden">
                      {menuLinks.map((item) => (
                        <a href={item[0]} class="font-semibold hover:text-blue-600">{item[1]}</a>
                      ))}
                    </div>
                    <a href="https://discord.com" class="max-lg:hidden hover:text-blue-600" aria-label="Discord"><DiscordLogo width="32" height="32" /></a>
                    <button id="mobileMenuBtn" type="button" class="lg:hidden" aria-controls="mobileMenu" aria-label="Toggle menu">M</button> <!-- placeholder -->
                </nav>
                <nav id="mobileMenu" class="flex-col gap-y-2 pt-2 hidden">
                    {menuLinks.map((item) => (
                      <a href={item[0]} class="font-semibold hover:text-blue-600">{item[1]}</a>
                    ))}
                    <a href="https://discord.com" class="hover:text-blue-600" aria-label="Discord"><DiscordLogo width="32" height="32" /></a>
                </nav>
            </div>
        </div>
    </header>
    <script is:inline>
        const mobileMenuBtn = document.querySelector("#mobileMenuBtn");
        const mobileMenu = document.querySelector("#mobileMenu");
        mobileMenuBtn.addEventListener("click", () => {
            mobileMenu.classList.toggle("hidden");
            mobileMenu.classList.toggle("flex");
        });
    </script>
    <main>
      <slot />
    </main>
    <footer class="bg-black text-white mx-auto p-5">
      &copy; TaKAi board. Server infrastructure kindly provided by <a href="https://modeemi.fi/">Modeemi</a>.
    </footer>
  </body>
</html>