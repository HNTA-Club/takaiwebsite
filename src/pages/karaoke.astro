---
import Layout from "../layouts/Layout.astro";
import KaraokeApp from "../components/KaraokeApp";
---

<Layout title="HNTA Karaoke">
  <div class="space-y-4">
    <div>
      <h1 class="text-2xl font-bold text-site-text sm:text-3xl">
        Karaoke Song Library
      </h1>
      <p class="mt-1 text-xs text-site-text-muted">
        Search our anime karaoke collection, filter by artist or anime.
      </p>
    </div>

    {/* Community & Guide Links Bar */}
    <div class="flex flex-wrap items-center gap-4 border-b border-site-border pb-3 text-xs font-medium">
      <a
        href="https://discord.com/channels/501030515537608705/1180844304466460682"
        target="_blank"
        rel="noreferrer"
        class="text-brand-purple-text hover:underline"
      >
        💬 Discord Karaoke Thread
      </a>
      <a
        href="https://docs.google.com/document/d/1hSYBtROm4BwvjohrkAhErUK8MxWyBs8X77ogujkFfQs/edit?usp=sharing"
        target="_blank"
        rel="noreferrer"
        class="text-brand-pink hover:underline"
      >
        📖 How to make a karaoke song
      </a>
    </div>

    {/* React Karaoke Island */}
    <KaraokeApp client:load />
  </div>
</Layout>
